{
  "name": "logpulse-engine",
  "version": "2.0.0",
  "description": "High-throughput log ingestion engine with batched queue processing, Redis TTL rate-limiting, alerting, and observability.",
  "main": "src/server.js",
  "bin": {
    "logpulse": "./cli/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:queue": "node tests/validateQueue.js",
    "test:unit": "node tests/search.test.js && node tests/alerts.test.js",
    "cli": "node cli/index.js",
    "generate:samples": "node scripts/generate-sample-logs.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}